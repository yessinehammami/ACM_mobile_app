{
  "name": "frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/ios": "^8.4.1",
    "preact": "^10.29.3",
    "papaparse": "^5.4.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.5",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "vite": "^8.1.1"
  },
  "build": {
    "appId": "com.acmapp.dm",
    "productName": "AMC DM",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
